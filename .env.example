# Free client_id from https://devportal.jamendo.com/ — needed only for the
# "Playlist" music mode. The "Radio" mode (SomaFM) works without any keys.
VITE_JAMENDO_CLIENT_ID=

# Fine-grained GitHub token scoped to ONLY this repo, "Contents: Read and
# write" permission — needed only for the "Отправить в GitHub" button on
# the debug log page. This gets built into the public JS bundle, so keep
# its scope minimal (this repo only, nothing else).
VITE_GITHUB_LOG_TOKEN=
